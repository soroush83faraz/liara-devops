# ---- Required in production ------------------------------------------------
# Session cookie encryption key (32+ random characters). Generate: openssl rand -base64 48
APP_SESSION_KEY=
# Key for one-time approval tokens (32+ random chars; falls back to APP_SESSION_KEY via HKDF if empty)
APP_APPROVAL_KEY=

# ---- AI copilot (Liara AI gateway, OpenAI-compatible; chat completions only) ---
# Full base URL ending in /v1, e.g. https://ai.liara.ir/api/<workspaceId>/v1
LIARA_AI_BASE_URL=
LIARA_AI_API_KEY=
# Model id as listed by the gateway (must be included in your AI plan), e.g. anthropic/claude-sonnet-5.5
LLM_MODEL=
# Optional cheaper model for intent routing
LLM_ROUTER_MODEL=
# Optional fallback provider (any OpenAI-compatible endpoint)
FALLBACK_AI_BASE_URL=
FALLBACK_AI_API_KEY=
FALLBACK_LLM_MODEL=

# ---- Storage ----------------------------------------------------------------
# Where layouts, proposals, incidents and the audit log are kept. On Liara, mount a disk and point this at it.
DATA_DIR=./data

# ---- Network -------------------------------------------------------------------
# Reverse proxies in front of the server that append to X-Forwarded-For (default 1 = Liara's ingress).
# The login rate limiter trusts only the entry this many hops from the right; 0 = no proxy (headers ignored).
TRUSTED_PROXY_HOPS=1

# ---- Live tests and spike scripts only (never read by the running product) --
# Users paste their own key in the UI; these are for `npm run test:live` / `npm run spike`.
LIARA_API_TOKEN=
LIARA_TEAM_ID=
# Name of the throwaway app live tests may restart / modify
LIARA_TEST_APP=
# Allow live tests that create or change billed resources (default off)
ALLOW_BILLED_LIVE_TESTS=
# Comma-separated model ids for `npm run eval`
LLM_EVAL_MODELS=

# ---- Development only --------------------------------------------------------
# Serve the copilot UI from a deterministic mock stream (ignored in production builds)
NEXT_PUBLIC_COPILOT_MOCK=

# ---- Testing only (ignored when NODE_ENV=production) --------------------------
# Point the server at a local fake Liara for e2e. Loopback only (127.0.0.1, localhost, [::1]), e.g. http://127.0.0.1:4010
LIARA_API_BASE_URL=
